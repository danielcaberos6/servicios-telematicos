# Copia este archivo como secret.env (no se sube al repositorio) y cambia los valores.
# APP_KEY:      echo "base64:$(openssl rand -base64 32)"
# DB_PASSWORD:  openssl rand -hex 16
APP_KEY=base64:CAMBIAR
DB_PASSWORD=CAMBIAR
# Solo con APP_ENV=production (sin cuentas de demostración): crea el
# administrador al arrancar. Quita el # y elige una contraseña propia.
# ADMIN_CORREO=admin@tu-dominio.com
# ADMIN_CONTRASENA=CAMBIAR
