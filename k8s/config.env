# local carga las cuentas de demostración (incluido el administrador) y las
# subastas de ejemplo. En production no se crea ninguna cuenta.
APP_ENV=local
APP_DEBUG=false
# IP de cualquier nodo y el NodePort del Service subastaya.
APP_URL=http://192.168.1.8:30080
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=subastaya
DB_USERNAME=subastaya
